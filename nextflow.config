nextflow.enable.dsl = 2


params {

    draft        = null
    hifi         = null
    ont          = null
    wgs = null
    illumina = null
    mgi = null

    // `predict` applies a pretrained model; `train` builds truth VCFs and trains CatBoost.
    workflow_mode = "predict"
    ml_model     = null
    ml_model_hap1 = null
    ml_model_hap2 = null
    ml_threshold = 0.5
    truth_fasta = null
    truth_fasta_hap1 = null
    truth_fasta_hap2 = null

    // Set individual tools to false in a params file to skip them.
    run_deepvariant = true
    run_pepper = true
    run_original_t2t = true
    run_auto_polish = true
    run_nextpolish2 = true
    run_sniffles = true
    run_cutesv = true
    run_flagger = true
    run_merqury = true
    run_medaka = true

    flagger_bed = null
    merqury_bed = null
    flagger_bed_hap1 = null
    flagger_bed_hap2 = null
    merqury_bed_hap1 = null
    merqury_bed_hap2 = null

    outdir       = "results"

    ploidy = "haploid"

    hap1 = null
    hap2 = null

    haplotype_delta = 0.01
    haplotype_min_mapq = 10

    mapping_container      = "metapolisher-align:2.0"
    deepvariant_container  = "google/deepvariant:1.10.0"
    pepper_container       = "kishwars/pepper_deepvariant:r0.8"
    sv_container           = "metapolisher-sv:2.0"
    polishing_container    = "metapolisher-polish:2.0"
    flagger_container      = "mobinasri/flagger:v1.2.1"
    ml_container            = "metapolisher-ml:2.0"
    truth_container         = "metapolisher-truth:1.0"
}


profiles {

    /*
     * =========================================================
     * LOCAL
     * =========================================================
     */

    local {

        process {

            executor = 'local'

            cpus = 32
            memory = '300 GB'
            time = '240h'

            errorStrategy = 'terminate'
        }

        docker.enabled = true
        singularity.enabled = false
    }


    /*
     * =========================================================
     * SLURM
     * =========================================================
     */

    slurm {

        process {

            executor = 'slurm'

            cpus = 8
            memory = '32 GB'
            time = '240h'

            errorStrategy = 'terminate'
        }

        process {

            withName: ALIGN_WGS {

                cpus = 32
                memory = '128 GB'
                time = '48h'
            }

            withName: ALIGN_ONT {

                cpus = 32
                memory = '128 GB'
                time = '48h'
            }

            withName: ALIGN_HIFI {

                cpus = 32
                memory = '128 GB'
                time = '48h'
            }

            withName: DEEPVARIANT {

                cpus = 16
                memory = '64 GB'
                time = '48h'
            }

            withName: PEPPER {

                cpus = 32
                memory = '128 GB'
                time = '48h'
            }

            withName: ORIGINAL_T2T {

                cpus = 16
                memory = '64 GB'
                time = '24h'
            }

            withName: AUTO_POLISH {

                cpus = 32
                memory = '128 GB'
                time = '72h'
            }

            withName: NP2 {

                cpus = 32
                memory = '128 GB'
                time = '72h'
            }

            withName: MEDAKA {

                cpus = 16
                memory = '64 GB'
                time = '48h'
            }

            withName: SNIFFLES_ONT {

                cpus = 16
                memory = '64 GB'
                time = '24h'
            }

            withName: SNIFFLES_HIFI {

                cpus = 16
                memory = '64 GB'
                time = '24h'
            }

            withName: CUTESV_ONT {

                cpus = 16
                memory = '64 GB'
                time = '24h'
            }

            withName: CUTESV_HIFI {

                cpus = 16
                memory = '64 GB'
                time = '24h'
            }


            withName: FLAGGER {

                cpus = 16
                memory = '64 GB'
                time = '24h'
            }

            withName: MERQURY {

                cpus = 16
                memory = '64 GB'
                time = '48h'
            }

            withName: ML_PREDICT {

                cpus = 16
                memory = '32 GB'
                time = '24h'
            }

            withName: ML_TRAIN {

                cpus = 16
                memory = '64 GB'
                time = '48h'
            }

            withName: TRUTH_VCF {

                cpus = 32
                memory = '128 GB'
                time = '48h'
            }
        }
    }
}


timeline {

    enabled = true

    file = "${params.outdir}/timeline.html"
}

report {

    enabled = true

    file = "${params.outdir}/report.html"
}


trace {

    enabled = true

    file = "${params.outdir}/trace.txt"
}
