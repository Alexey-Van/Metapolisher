nextflow.enable.dsl = 2


params {

    draft        = null
    hifi         = null
    ont          = null
    illumina_r1  = null
    illumina_r2  = null

    truth_vcf    = null

    mode         = "train"

    outdir       = "results"

    mapping_container      = "metapolisher-align:1.0"
    deepvariant_container  = "google/deepvariant:1.9.0"
    pepper_container       = "kishwars/pepper_deepvariant:r0.8"
    sv_container           = "metapolisher-sv:1.0"
    polishing_container    = "metapolisher-polish:1.0"
    flagger_container      = "mobinasri/flagger:v1.1.0"
    ml_container            = "metapolisher-ml:1.0"
}


profiles {

    /*
     * =========================================================
     * LOCAL
     * =========================================================
     */

    local {

        process {

            executor = 'local'

            cpus = 8
            memory = '16 GB'
            time = '240h'

            errorStrategy = 'terminate'
        }

        docker.enabled = true
        singularity.enabled = false
    }


    /*
     * =========================================================
     * SLURM
     * =========================================================
     */

    slurm {

        process {

            executor = 'slurm'

            cpus = 8
            memory = '32 GB'
            time = '240h'

            errorStrategy = 'terminate'
        }

        process {

            withName: ALIGN_ALL {

                cpus = 32
                memory = '128 GB'
                time = '48h'
            }

            withName: DEEPVARIANT {

                cpus = 16
                memory = '64 GB'
                time = '48h'
            }

            withName: PEPPER {

                cpus = 32
                memory = '128 GB'
                time = '48h'
            }

            withName: ORIGINAL_T2T {

                cpus = 16
                memory = '64 GB'
                time = '24h'
            }

            withName: AUTO_POLISH {

                cpus = 32
                memory = '128 GB'
                time = '72h'
            }

            withName: NP2 {

                cpus = 32
                memory = '128 GB'
                time = '72h'
            }

            withName: MEDAKA {

                cpus = 16
                memory = '64 GB'
                time = '48h'
            }

            withName: SNIFFLES_ONT {

                cpus = 16
                memory = '64 GB'
                time = '24h'
            }

            withName: SNIFFLES_HIFI {

                cpus = 16
                memory = '64 GB'
                time = '24h'
            }

            withName: CUTESV_ONT {

                cpus = 16
                memory = '64 GB'
                time = '24h'
            }

            withName: CUTESV_HIFI {

                cpus = 16
                memory = '64 GB'
                time = '24h'
            }


            withName: FLAGGER {

                cpus = 16
                memory = '64 GB'
                time = '24h'
            }

            withName: MERQURY {

                cpus = 16
                memory = '64 GB'
                time = '48h'
            }
        }
    }
}


timeline {

    enabled = true

    file = "${params.outdir}/timeline.html"
}

report {

    enabled = true

    file = "${params.outdir}/report.html"
}


trace {

    enabled = true

    file = "${params.outdir}/trace.txt"
}